						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Evento Sin Auth\",\n  \"date\": \"{{newEventDate}}\",\n  \"location\": \"Estadio Nacional\",\n  \"venueName\": \"Estadio Nacional - Bogotá\",\n  \"ticketConfigurations\": [\n    {\n      \"type\": \"GENERAL\",\n      \"price\": 50,\n      \"currency\": \"USD\",\n      \"quantity\": 100\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/events",
